# Copie este archivo como .env (en la carpeta backend) y complete los valores.
# El archivo .env no debe subirse al repositorio.

# Base de desarrollo en PostgreSQL local (puerto 5432).
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/Sistema-de-diagnostico

# Secreto para firmar las sesiones (mínimo 32 caracteres). Genere uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
JWT_MINUTOS_VALIDEZ=480

# Origen del frontend de Vite autorizado a llamar a la API.
ORIGENES_CORS=http://localhost:5173

# Solo para pytest: base EXCLUSIVA de pruebas; su esquema public se borra en cada ejecución.
TEST_DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/sistema_diagnostico_pruebas
